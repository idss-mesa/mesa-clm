# mesa-clm environment. Copy to .env (gitignored) and uncomment what you set. The prefix
# MESA_CLM_ plus a double underscore maps onto the nested config: MESA_CLM_<SECTION>__<FIELD>.
# Precedence (highest wins): CLI flag > env var > YAML file (--config) > defaults.
# Names only here: every line is commented out because an empty value means "unset", and a
# blank for a non-optional field would fail validation. Defaults are in config.yaml.example.
# Never write a key into this file's copy if the shell history or a backup could pick it up;
# prefer a 0600 key file (*_API_KEY_FILE) or the system keyring (MESA_CLM_SECRETS=keyring).

# --- secrets source -------------------------------------------------------------------------
# auto (first configured of value, file, keyring) | env (values only) | file (*_API_KEY_FILE
# only) | keyring (service mesa-clm, users clm | encoder | gateway; needs the keyring package).
# MESA_CLM_SECRETS=

# --- clm-serve (the heads; plan §6.2) --------------------------------------------------------
# Loopback only (127.0.0.1, localhost, ::1). A remote host needs ALLOW_REMOTE=1 AND https://;
# plain http to a remote host is refused: forward the port with ssh -L instead (D16, §6.4).
# With neither API_KEY nor API_KEY_FILE set, the key is read from ~/.mesa/clm/secrets/clm.key
# when that file exists (`mesa-clm serve keys --init` writes it; secrets modes auto and file);
# setting API_KEY_FILE to an empty value switches that default off. The same for the encoder
# with ~/.mesa/clm/secrets/encoder.key.
# MESA_CLM_CLM__BASE_URL=
# MESA_CLM_CLM__API_KEY=
# MESA_CLM_CLM__API_KEY_FILE=
# MESA_CLM_CLM__MODEL=
# MESA_CLM_CLM__TIMEOUT=
# MESA_CLM_CLM__ALLOW_REMOTE=
# CLM's own client names are honoured as fallbacks when the native names above are unset
# (CLM_API_KEY only when neither MESA_CLM_CLM__API_KEY nor MESA_CLM_CLM__API_KEY_FILE is set).
# CLM_BASE_URL=
# CLM_API_KEY=

# --- encoder (vLLM pooling, Qwen3-8B; plan §6.1) ---------------------------------------------
# MESA_CLM_ENCODER__URL=
# MESA_CLM_ENCODER__API_KEY=
# MESA_CLM_ENCODER__API_KEY_FILE=
# MESA_CLM_ENCODER__MODEL=
# MESA_CLM_ENCODER__MAX_LEN=
# MESA_CLM_ENCODER__TIMEOUT=
# The pinned Qwen3 tokenizer.json, counted by the `tokenize` extra when the encoder has no /tokenize:
# MESA_CLM_ENCODER__TOKENIZER_JSON=

# --- decider tier (D6, D28) -----------------------------------------------------------------
# auto | zero_shot | calibrated | probe | head | ols_rank (the degraded method, proposed-only)
# MESA_CLM_DECIDER__TIER=
# true: `annotate --provider clm` at tier auto runs ols_rank when clm-serve is down (default: refuse)
# MESA_CLM_DECIDER__OLS_RANK_FALLBACK=

# --- planner (the reasoning model; plans, never decides, D22) ---------------------------------
# static (rule fallback, default) | gateway (CARC LiteLLM over a loopback tunnel) | claude
# MESA_CLM_PLANNER__KIND=
# MESA_CLM_PLANNER__GATEWAY_BASE_URL=
# MESA_CLM_PLANNER__GATEWAY_API_KEY=
# MESA_CLM_PLANNER__GATEWAY_API_KEY_FILE=
# MESA_CLM_PLANNER__GATEWAY_MODEL=
# MESA_CLM_PLANNER__CLAUDE_MODEL=
# MESA_CLM_PLANNER__CLAUDE_EFFORT=
# MESA_CLM_PLANNER__TIMEOUT=
# mesa-mcp's names are honoured as fallbacks for the gateway when the native names are unset
# (a trailing /v1 on MESA_LLM_BASE_URL is stripped; MESA_LLM_API_KEY only when neither
# GATEWAY_API_KEY nor GATEWAY_API_KEY_FILE is set).
# MESA_LLM_BASE_URL=
# MESA_LLM_API_KEY=

# --- Claude second opinion (never auto; credentials through the SDK: ANTHROPIC_API_KEY) --------
# MESA_CLM_CLAUDE__MODEL=
# MESA_CLM_CLAUDE__EFFORT=
# MESA_CLM_CLAUDE__MAX_TOKENS=
# MESA_CLM_CLAUDE__SECOND_OPINION=
# MESA_CLM_CLAUDE__SECOND_OPINION_TOP_K=

# --- write policy (§4.7) ---------------------------------------------------------------------
# prod: auto needs a calibrated tier with a cited cell and an audit; dev: proposed-only, no history ok.
# MESA_CLM_POLICY__PROFILE=
# MESA_CLM_POLICY__POLICY_PATH=
# MESA_CLM_POLICY__MAX_CANDIDATES=
# MESA_CLM_POLICY__MAX_AVUS=
# MESA_CLM_POLICY__PROPOSAL_SIZE=
# MESA_CLM_POLICY__MAX_WAIT_S=
# MESA_CLM_POLICY__SPECIFICITY=
# MESA_CLM_POLICY__SPECIFICITY_DELTA=

# --- artifacts, features, provenance sidecar (~/.mesa/clm/) ------------------------------------
# MESA_CLM_ARTIFACTS__DIR=
# MESA_CLM_ARTIFACTS__STRICT=
# MESA_CLM_FEATURES__DIR=
# MESA_CLM_PROVENANCE__DSN=
# MESA_CLM_PROVENANCE__TTL_DAYS=

# --- mesa-ducklake (history direct mode; local lake for the CLI and tests) ----------------------
# The shared MESA catalog (duckdb:///~/.mesa/ducklake/catalog.duckdb) must be named explicitly.
# MESA_CLM_DUCKLAKE__CATALOG_DSN=
# MESA_CLM_DUCKLAKE__CACHE_DIR=
# MESA_CLM_DUCKLAKE__CACHE_CAP_BYTES=
# MESA_CLM_DUCKLAKE__LOCAL_PROJECT_ROOT=
# MESA_CLM_DUCKLAKE__LOCAL_ZONE=

# --- history backend (D12) -------------------------------------------------------------------
# direct (CLI only; needs the whole lock set free) | spool (mesa-spool/1 batches) | none | auto
# MESA_CLM_HISTORY__BACKEND=
# MESA_CLM_HISTORY__MULTIWRITER=
# MESA_CLM_HISTORY__SPOOL_ROOT=
# MESA_CLM_HISTORY__LOCK_PATH=
# MESA_CLM_HISTORY__NEON_LOCK_PATH=
# MESA_HOME moves the default of HISTORY__LOCK_PATH to $MESA_HOME/locks/mesa-catalog.lock.
# MESA_HOME=

# --- apply pacing (§7.3 step 5) ----------------------------------------------------------------
# MESA_CLM_APPLY__MAX_CALLS_PER_S=

# --- OLS ---------------------------------------------------------------------------------------
# fixtures: off | record | replay | auto (record and auto reach EBI; replay is strictly offline)
# MESA_CLM_OLS__BASE_URL=
# MESA_CLM_OLS__FIXTURES=
# MESA_CLM_OLS__FIXTURES_DIR=

# --- neon-ducklake adapter root (0.2.0, §7.4) and card size limit (D29) -------------------------
# MESA_CLM_NEON__ROOT=
# MESA_CLM_CARD__MAX_BYTES=

# --- bench and labels ----------------------------------------------------------------------------
# The neon-avu-eval checkout (cards, results/validated.json). Tests use tests/fixtures/neon-avu-eval.
# MESA_CLM_EVAL_ROOT=
# This host's name on runs and spool batches (one path segment; default: the hostname).
# MESA_CLM_VM_ID=

# --- opt-in test tiers (read by tests/conftest.py, not settings) -----------------------------------
# MESA_CLM_LIVE=1          # real EBI OLS / Claude API
# MESA_CLM_ENGINE=1        # real CLM stack (encoder :8090 + clm-serve :8700)
# MESA_CLM_GPU=1           # serve venv + CUDA
# MESA_CLM_E2E=1           # real mesa-mcp over MCP stdio
# MESA_CLM_TEST_PG_DSN=    # Postgres sidecar dialect
# MESA_CLM_NEON_ROOT=      # a neon-ducklake root for the adapter tests
