# mesa-clm clm-serve: patched CLM on 127.0.0.1:8700, heads on CPU (plan §6.2; DESIGN D17).
# Generated by mesa_clm.serving.render_units(); deploy/systemd/ holds this rendering.
# Install into ~/.config/systemd/user/ and `systemctl --user daemon-reload`; installing does
# not enable it (enabling starts it at boot and waits for the CARC GPU allocation).
[Unit]
Description=mesa-clm clm-serve (patched CLM System One API on 127.0.0.1:8700)
Documentation=https://idss-mesa.github.io/mesa-clm/deploy/serving/
Requires=mesa-clm-encoder.service
After=mesa-clm-encoder.service

[Service]
Type=simple
EnvironmentFile=%h/.mesa/clm/secrets/clm.env
Environment=HF_HUB_OFFLINE=1
Environment=PYTHONUNBUFFERED=1
ExecStartPre=%h/.mesa/clm/bin/mesa-clm-wait-http http://127.0.0.1:8090/health 600
ExecStart=%h/.mesa/clm/serve/.venv/bin/clm-serve --host 127.0.0.1 --port 8700 \
    --emb-url http://127.0.0.1:8090/v1/embeddings --emb-model qwen3-8b \
    --max-tokens 4095 --ckpt %h/.mesa/clm/heads/CLM_v0.1-8B.pt --ckpt-dir %h/.mesa/clm/heads/served \
    --device cpu --action-cache 512MiB --no-download --no-ui
Restart=on-failure
RestartSec=10
TimeoutStartSec=660
SyslogIdentifier=mesa-clm-serve

[Install]
WantedBy=default.target
