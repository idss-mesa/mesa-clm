# mesa-clm encoder endpoint: 127.0.0.1:8090, forwarded to the container's unix socket (DESIGN A5).
# Generated by mesa_clm.serving.render_units(); deploy/systemd/ holds this rendering.
# Install into ~/.config/systemd/user/ and `systemctl --user daemon-reload`; installing does
# not enable it (enabling starts it at boot and waits for the CARC GPU allocation).
# Started before mesa-clm-encoder.service, which requires it (Requires=, After=), and stopped with
# it (PartOf=); a port it cannot bind fails the encoder. Without an install section it can never
# be enabled on its own.
[Unit]
Description=mesa-clm encoder endpoint (127.0.0.1:8090)
Documentation=https://idss-mesa.github.io/mesa-clm/deploy/serving/
PartOf=mesa-clm-encoder.service

[Socket]
ListenStream=127.0.0.1:8090
NoDelay=true
