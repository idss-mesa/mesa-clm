# mesa-clm encoder proxy: connections on 127.0.0.1:8090 to %h/.mesa/clm/run/encoder.sock (DESIGN A5).
# Generated by mesa_clm.serving.render_units(); deploy/systemd/ holds this rendering.
# Install into ~/.config/systemd/user/ and `systemctl --user daemon-reload`; installing does
# not enable it (enabling starts it at boot and waits for the CARC GPU allocation).
# Socket-activated by mesa-clm-encoder-proxy.socket. The encoder container creates the
# socket in a 0700 directory, so only this account can reach it.
[Unit]
Description=mesa-clm encoder proxy (127.0.0.1:8090 to the encoder's unix socket)
Documentation=https://idss-mesa.github.io/mesa-clm/deploy/serving/
Requires=mesa-clm-encoder-proxy.socket
After=mesa-clm-encoder-proxy.socket
PartOf=mesa-clm-encoder.service

[Service]
Type=notify
ExecStart=/usr/lib/systemd/systemd-socket-proxyd %h/.mesa/clm/run/encoder.sock
SyslogIdentifier=mesa-clm-encoder-proxy
