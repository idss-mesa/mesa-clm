# mesa-clm encoder: vLLM pooling Qwen/Qwen3-8B behind 127.0.0.1:8090, pinned by digest (plan §6.1).
# Generated by mesa_clm.serving.render_units(); deploy/systemd/ holds this rendering.
# Install into ~/.config/systemd/user/ and `systemctl --user daemon-reload`; installing does
# not enable it (enabling starts it at boot and waits for the CARC GPU allocation).
[Unit]
Description=mesa-clm encoder (vLLM pooling Qwen3-8B behind 127.0.0.1:8090)
Documentation=https://idss-mesa.github.io/mesa-clm/deploy/serving/
# The container has no network and serves on a unix socket; mesa-clm-encoder-proxy.socket owns
# 127.0.0.1:8090 (DESIGN A5). The encoder requires it and starts after it, so a port that cannot
# be bound (another account holds it) fails the encoder, and clm-serve with it, instead of
# leaving clm-serve to send the encoder key to that account. The headroom timer runs while the
# encoder does (plan §6.5); both stop with it (PartOf=).
Requires=mesa-clm-encoder-proxy.socket
After=mesa-clm-encoder-proxy.socket
Wants=mesa-clm-headroom.timer
# Every start counts, manual ones included: a fourth start within an hour is refused
# (start-limit-hit), which keeps a recipe that fails after the model load (about 70-80 s and
# 14 GiB on the shared GPU each time) from reloading every few minutes. Run
# `systemctl --user reset-failed mesa-clm-encoder.service` before restarting it by hand.
StartLimitIntervalSec=1h
StartLimitBurst=3

[Service]
Type=simple
# The user manager does not carry the docker group, hence sg (RESEARCH.md, sparky-1 host facts).
ExecStartPre=-/usr/bin/sg docker -c "docker rm -f mesa-clm-encoder"
ExecStartPre=%h/.mesa/clm/bin/mesa-clm-check-headroom 32
ExecStart=/usr/bin/sg docker -c "exec %h/.mesa/clm/bin/mesa-clm-encoder-run"
ExecStop=/usr/bin/sg docker -c "docker stop -t 30 mesa-clm-encoder"
SuccessExitStatus=143
Restart=on-failure
RestartSec=30
TimeoutStartSec=900
TimeoutStopSec=60
SyslogIdentifier=mesa-clm-encoder

[Install]
WantedBy=default.target
