# mesa-clm headroom check: fails when MemAvailable < 8 GiB (plan §6.5; GB10 unified memory).
# Generated by mesa_clm.serving.render_units(); deploy/systemd/ holds this rendering.
# Install into ~/.config/systemd/user/ and `systemctl --user daemon-reload`; installing does
# not enable it (enabling starts it at boot and waits for the CARC GPU allocation).
[Unit]
Description=mesa-clm headroom check (MemAvailable >= 8 GiB)
Documentation=https://idss-mesa.github.io/mesa-clm/deploy/serving/

[Service]
Type=oneshot
ExecStart=%h/.mesa/clm/bin/mesa-clm-check-headroom 8
