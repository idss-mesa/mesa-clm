# The serve venv (~/.mesa/clm/serve/.venv; uv CPython 3.11.16, aarch64, CUDA 13.0 driver).
# It runs the patched clm-serve (CPU heads), serving/export_head.py and serving/fallback_serve.py.
# It never imports mesa_clm, and it never contains vllm: the encoder is the pinned container
# (plan §6.1) and contrastive-lm's unconditional `vllm>=0.6` is skipped by installing the CLM
# clone with `--no-deps` (DESIGN D0).
#
# Regenerate the hash-pinned lock (then update the sha256 of this lock in the docs if cited):
#   uv pip compile serving/requirements-serve.in --python-version 3.11 \
#     --python-platform aarch64-unknown-linux-gnu --generate-hashes -o serving/requirements-serve.txt

# PyPI's aarch64 torch 2.14.0 wheel is a CUDA 13.0 build (cuda-toolkit==13.0.3, nvidia-*-cu13,
# triton~=3.8.0), matching driver 580.173.02 / CUDA 13.0 on the GB10.
torch==2.14.0
